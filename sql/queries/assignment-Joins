SELECT city
FROM delivery_agents

UNION

SELECT city
FROM delivery_hubs;
41–65: GROUP BY and Aggregate Functions
41. Number of agents in each hub
SELECT dh.hub_name,
       COUNT(da.agent_id) AS total_agents
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
42. All hubs including those with no agents
SELECT dh.hub_name,
       COUNT(da.agent_id) AS total_agents
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
43. Total salary of agents in each hub
SELECT dh.hub_name,
       COALESCE(SUM(da.salary), 0) AS total_salary
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
44. Average salary of agents
SELECT dh.hub_name,
       AVG(da.salary) AS average_salary
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
45. Highest salary in each hub
SELECT dh.hub_name,
       MAX(da.salary) AS highest_salary
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
46. Lowest salary in each hub
SELECT dh.hub_name,
       MIN(da.salary) AS lowest_salary
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
47. Total incentive per hub
SELECT dh.hub_name,
       COALESCE(SUM(da.incentive), 0) AS total_incentive
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
48. Total earnings of agents in each hub
SELECT dh.hub_name,
       COALESCE(SUM(da.salary + da.incentive), 0) AS total_earnings
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
49. Average total earnings
SELECT dh.hub_name,
       AVG(da.salary + da.incentive) AS average_total_earnings
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;
50. Number of active agents in each hub
SELECT dh.hub_name,
       COUNT(CASE WHEN da.status = 'Active' THEN 1 END) AS active_agents
FROM delivery_hubs dh
LEFT JOIN delivery_agents da
ON dh.hub_id = da.hub_id
GROUP BY dh.hub_id, dh.hub_name;