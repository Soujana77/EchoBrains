-- 1. Display all employee records.

SELECT *
FROM employees;


-- 2. Display only the employee name and salary.

SELECT name, salary
FROM employees;


-- 3. Display the employee name and salary after adding 5000 to the salary.

SELECT name, salary + 5000 AS salary_after_addition
FROM employees;


-- 4. Display the employee name and salary after deducting 2000 from the salary.

SELECT name, salary - 2000 AS salary_after_deduction
FROM employees;


-- 5. Display the employee name and double the bonus.

SELECT name, bonus * 2 AS double_bonus
FROM employees;


-- 6. Display the employee name and annual salary.

SELECT name, salary * 12 AS annual_salary
FROM employees;


-- 7. Display the employee name, salary, and bonus along with the total amount of salary and bonus.

SELECT name, salary, bonus, salary + bonus AS total_amount
FROM employees;


-- 8. Display the employee name as Employee_Name and salary as Monthly_Salary.

SELECT name AS Employee_Name, salary AS Monthly_Salary
FROM employees;


-- 9. Display the employee name as Employee_Name and annual salary as Annual_Salary.

SELECT name AS Employee_Name, salary * 12 AS Annual_Salary
FROM employees;


-- 10. Display all details of employees working in the IT department.

SELECT *
FROM employees
WHERE dept = 'IT';

