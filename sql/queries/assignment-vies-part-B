PART B — ELECTRONICS

Your electronics table contains product_id, product_name, brand, category, price, stock, warranty_years, city, supplier, status.

1. Basic product details
CREATE VIEW product_basic_details AS
SELECT product_id, product_name, brand, category, city
FROM electronics;
2. Hide supplier
CREATE VIEW product_without_supplier AS
SELECT product_name, brand, category, price, stock
FROM electronics;
3. Available products
CREATE VIEW available_products AS
SELECT *
FROM electronics
WHERE status = 'Available';
4. Laptop products
CREATE VIEW laptop_products AS
SELECT *
FROM electronics
WHERE category = 'Laptop';
5. Products priced above 20,000
CREATE VIEW expensive_products AS
SELECT *
FROM electronics
WHERE price > 20000;
6. Stock value
CREATE VIEW product_stock_value AS
