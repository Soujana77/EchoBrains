-- 1. Display the total stock value of all products using price * quantity.
SELECT SUM(price * quantity) AS total_stock_value
FROM product;


-- 2. Display the category-wise total stock value using price * quantity.
SELECT category, SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category;


-- 3. Display categories whose total stock value is greater than 500000.
SELECT category, SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
HAVING SUM(price * quantity) > 500000;


-- 4. Display the product names and order dates, arranged from newest order to oldest order.
SELECT product_name, order_date
FROM product
ORDER BY order_date DESC;


-- 5. Display the total quantity and average price for each category.
SELECT category,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price
FROM product
GROUP BY category;


-- 6. Display the first 2 suppliers based on their total supplied quantity.
SELECT supplier, SUM(quantity) AS total_supplied_quantity
FROM product
GROUP BY supplier
ORDER BY SUM(quantity) DESC
LIMIT 2;


-- 7. Display the different combinations of category and city.
SELECT DISTINCT category, city
FROM product;


-- 8. Display the category-wise total discount and arrange the categories
-- from highest total discount to lowest.
SELECT category, SUM(discount) AS total_discount
FROM product
GROUP BY category
ORDER BY SUM(discount) DESC;


-- 9. Display cities whose average product price is greater than 10000.
SELECT city, AVG(price) AS average_price
FROM product
GROUP BY city
HAVING AVG(price) > 10000;


-- 10. Display the product name, category, price, and calculated final price
-- after subtracting the discount, arranged by final price from highest to lowest.
SELECT product_name,
       category,
       price,
       (price - discount) AS final_price
FROM product
ORDER BY final_price DESC;


--41. Number of products supplied by each supplier, only suppliers having more than one product
SELECT supplier, COUNT(*) AS number_of_products
FROM product
GROUP BY supplier
HAVING COUNT(*) > 1;
--42. Category-wise average price, only categories whose average price is between 5000 and 20000
SELECT category, AVG(price) AS average_price
FROM product
GROUP BY category
HAVING AVG(price) BETWEEN 5000 AND 20000;
--43. 3 products having the highest quantity
SELECT *
FROM product
ORDER BY quantity DESC
LIMIT 3;
--44. Total quantity available in each city, highest to lowest
SELECT city, SUM(quantity) AS total_quantity
FROM product
GROUP BY city
ORDER BY total_quantity DESC;
--45. Categories whose total quantity is greater than 40
SELECT category, SUM(quantity) AS total_quantity
FROM product
GROUP BY category
HAVING SUM(quantity) > 40;
--46. Product name, price, quantity, total stock value — top 5 by stock value
SELECT product_name,
       price,
       quantity,
       (price * quantity) AS total_stock_value
FROM product
ORDER BY total_stock_value DESC
LIMIT 5;
--47. Supplier-wise average product price, highest average to lowest
SELECT supplier, AVG(price) AS average_price
FROM product
GROUP BY supplier
ORDER BY average_price DESC;
--48. Category-wise number of products, total quantity, and average price
SELECT category,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price
FROM product
GROUP BY category;
--49. Categories having more than one product AND total quantity greater than 20
SELECT category,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY category
HAVING COUNT(*) > 1
AND SUM(quantity) > 20;
--50. Category-wise total stock value, highest to lowest, top 2 categories
SELECT category,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
ORDER BY total_stock_value DESC
LIMIT 2;

-- 51. Display the product name, price, and quantity for products whose
-- stock value (price * quantity) is greater than 200000,
-- and arrange them by stock value.

SELECT product_name, price, quantity, (price * quantity) AS stock_value
FROM product
WHERE (price * quantity) > 200000
ORDER BY stock_value DESC;


-- 52. Display the total quantity and total discount for each category.

SELECT category,
       SUM(quantity) AS total_quantity,
       SUM(discount) AS total_discount
FROM product
GROUP BY category;


-- 53. Display cities having more than one product and arrange them
-- based on their total product quantity.

SELECT city,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY city
HAVING COUNT(*) > 1
ORDER BY total_quantity DESC;


-- 54. Display the product names and prices for the second, third,
-- and fourth highest-priced products.

SELECT product_name, price
FROM product
ORDER BY price DESC
LIMIT 3 OFFSET 1;


-- 55. Display the category-wise maximum price and minimum price,
-- and arrange the categories based on maximum price.

SELECT category,
       MAX(price) AS maximum_price,
       MIN(price) AS minimum_price
FROM product
GROUP BY category
ORDER BY maximum_price DESC;


-- 56. Display the supplier-wise total quantity and show only suppliers
-- whose total quantity is greater than 20.

SELECT supplier,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY supplier
HAVING SUM(quantity) > 20;


-- 57. Display the product name, category, and total stock value
-- for the 3 products having the lowest stock value.

SELECT product_name,
       category,
       (price * quantity) AS total_stock_value
FROM product
ORDER BY total_stock_value ASC
LIMIT 3;


-- 58. Display the average price of products in each category and
-- show only categories whose average price is greater than 8000.

SELECT category,
       AVG(price) AS average_price
FROM product
GROUP BY category
HAVING AVG(price) > 8000;


-- 59. Display the different supplier and city combinations
-- without repeating the same combination.

SELECT DISTINCT supplier, city
FROM product;


-- 60. Display the category-wise total stock value and total discount.

SELECT category,
       SUM(price * quantity) AS total_stock_value,
       SUM(discount) AS total_discount
FROM product
GROUP BY category;

-- 61. Display the total number of products in each city
-- and arrange the result alphabetically by city.

SELECT city,
       COUNT(*) AS number_of_products
FROM product
GROUP BY city
ORDER BY city ASC;


-- 62. Display the product name, category, and price
-- for the 3 most expensive products.

SELECT product_name, category, price
FROM product
ORDER BY price DESC
LIMIT 3;


-- 63. Display the category-wise total quantity and show only
-- categories having a total quantity between 20 and 60.

SELECT category,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY category
HAVING SUM(quantity) BETWEEN 20 AND 60;


-- 64. Display the supplier-wise total stock value using price * quantity,
-- arranged from highest to lowest.

SELECT supplier,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY supplier
ORDER BY total_stock_value DESC;


-- 65. Display the city-wise average price and show only cities
-- whose average price is greater than 7000.

SELECT city,
       AVG(price) AS average_price
FROM product
GROUP BY city
HAVING AVG(price) > 7000;


-- 66. Display the product name, price, discount, and final price
-- after discount, from lowest final price to highest.

SELECT product_name,
       price,
       discount,
       (price - discount) AS final_price
FROM product
ORDER BY final_price ASC;


-- 67. Display categories having at least 2 products
-- and arrange them based on their average price.

SELECT category,
       COUNT(*) AS number_of_products,
       AVG(price) AS average_price
FROM product
GROUP BY category
HAVING COUNT(*) >= 2
ORDER BY average_price ASC;


-- 68. Display the total quantity of all products after excluding
-- the 2 products with the highest prices.

SELECT SUM(quantity) AS total_quantity
FROM product
WHERE product_id NOT IN (
    SELECT product_id
    FROM product
    ORDER BY price DESC
    LIMIT 2
);


-- 69. Display the category-wise total quantity and total stock value,
-- showing only categories whose total stock value is greater than 200000.

SELECT category,
       SUM(quantity) AS total_quantity,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
HAVING SUM(price * quantity) > 200000;


-- 70. Display the 3 suppliers having the highest total quantity.

SELECT supplier,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY supplier
ORDER BY total_quantity DESC
LIMIT 3;


-- 71. Display the number of products and average price for each supplier.

SELECT supplier,
       COUNT(*) AS number_of_products,
       AVG(price) AS average_price
FROM product
GROUP BY supplier;


-- 72. Display suppliers whose average product price is greater than 10000.

SELECT supplier,
       AVG(price) AS average_price
FROM product
GROUP BY supplier
HAVING AVG(price) > 10000;


-- 73. Display the product names and order dates for the 4 earliest orders.

SELECT product_name, order_date
FROM product
ORDER BY order_date ASC
LIMIT 4;


-- 74. Display the category-wise highest quantity and lowest quantity.

SELECT category,
       MAX(quantity) AS highest_quantity,
       MIN(quantity) AS lowest_quantity
FROM product
GROUP BY category;


-- 75. Display cities whose total quantity is greater than 30
-- and arrange them from highest total quantity to lowest.

SELECT city,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY city
HAVING SUM(quantity) > 30
ORDER BY total_quantity DESC;


-- 76. Display the category-wise total discount and show only
-- categories having total discount greater than 1000.

SELECT category,
       SUM(discount) AS total_discount
FROM product
GROUP BY category
HAVING SUM(discount) > 1000;


-- 77. Display the product name, price, quantity, and total stock value
-- for products where price * quantity is greater than 150000.

SELECT product_name,
       price,
       quantity,
       (price * quantity) AS total_stock_value
FROM product
WHERE (price * quantity) > 150000;


-- 78. Display the 2 categories having the highest average product price.

SELECT category,
       AVG(price) AS average_price
FROM product
GROUP BY category
ORDER BY average_price DESC
LIMIT 2;


-- 79. Display the supplier-wise number of products and total quantity,
-- showing only suppliers whose product count is greater than 1.

SELECT supplier,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY supplier
HAVING COUNT(*) > 1;


-- 80. Display the city-wise total stock value using price * quantity
-- and arrange the cities from highest to lowest.

SELECT city,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY city
ORDER BY total_stock_value DESC;

-- 81. Display categories whose total stock value is greater than
-- their total discount.

SELECT category,
       SUM(price * quantity) AS total_stock_value,
       SUM(discount) AS total_discount
FROM product
GROUP BY category
HAVING SUM(price * quantity) > SUM(discount);


-- 82. Display the product name, category, price, and quantity
-- for the 5 products with the highest quantity.

SELECT product_name, category, price, quantity
FROM product
ORDER BY quantity DESC
LIMIT 5;


-- 83. Display the category-wise average price and total quantity,
-- arranging by average price from highest to lowest.

SELECT category,
       AVG(price) AS average_price,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY category
ORDER BY average_price DESC;


-- 84. Display suppliers having more than one product
-- and a total quantity greater than 20.

SELECT supplier,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity
FROM product
GROUP BY supplier
HAVING COUNT(*) > 1
AND SUM(quantity) > 20;


-- 85. Display the total quantity and average price for each city,
-- showing only cities whose average price is greater than 5000.

SELECT city,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price
FROM product
GROUP BY city
HAVING AVG(price) > 5000;


-- 86. Display the category-wise total stock value
-- and show only the top 3 categories based on total stock value.

SELECT category,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
ORDER BY total_stock_value DESC
LIMIT 3;


-- 87. Display the product name, category, and calculated stock value,
-- skipping the first 2 products and displaying the next 3
-- based on highest stock value.

SELECT product_name,
       category,
       (price * quantity) AS stock_value
FROM product
ORDER BY stock_value DESC
LIMIT 3 OFFSET 2;


-- 88. Display the supplier-wise total discount and show only
-- suppliers whose total discount is greater than 500.

SELECT supplier,
       SUM(discount) AS total_discount
FROM product
GROUP BY supplier
HAVING SUM(discount) > 500;


-- 89. Display the category-wise number of products, total quantity,
-- and total stock value, arranged by total quantity descending.

SELECT category,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
ORDER BY total_quantity DESC;


-- 90. Display cities having more than one product, calculate
-- their average price, and show only cities whose average price
-- is greater than 8000.

SELECT city,
       COUNT(*) AS number_of_products,
       AVG(price) AS average_price
FROM product
GROUP BY city
HAVING COUNT(*) > 1
AND AVG(price) > 8000;


-- 91. Display the category-wise total stock value after
-- considering the discount for each product.

SELECT category,
       SUM((price * quantity) - discount) AS total_stock_value_after_discount
FROM product
GROUP BY category;


-- 92. Display the supplier-wise total quantity and average price,
-- arranging suppliers by total quantity from highest to lowest.

SELECT supplier,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price
FROM product
GROUP BY supplier
ORDER BY total_quantity DESC;


-- 93. Display the product name, category, and final value after
-- subtracting the discount from the total stock value,
-- and display the 5 highest values.

SELECT product_name,
       category,
       ((price * quantity) - discount) AS final_value
FROM product
ORDER BY final_value DESC
LIMIT 5;


-- 94. Display categories having more than one product
-- and whose average price is greater than 7000.

SELECT category,
       COUNT(*) AS number_of_products,
       AVG(price) AS average_price
FROM product
GROUP BY category
HAVING COUNT(*) > 1
AND AVG(price) > 7000;


-- 95. Display the city-wise number of products, total quantity,
-- and average price, showing only cities having more than one product.

SELECT city,
       COUNT(*) AS number_of_products,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price
FROM product
GROUP BY city
HAVING COUNT(*) > 1;


-- 96. Display the supplier-wise total stock value and show only
-- suppliers whose total stock value is greater than 100000.

SELECT supplier,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY supplier
HAVING SUM(price * quantity) > 100000;


-- 97. Display the category-wise total quantity and total discount,
-- arrange by total quantity descending, and display the first 2 categories.

SELECT category,
       SUM(quantity) AS total_quantity,
       SUM(discount) AS total_discount
FROM product
GROUP BY category
ORDER BY total_quantity DESC
LIMIT 2;


-- 98. Display the product name, category, price, quantity,
-- and calculated total stock value, arranging by category
-- and then by total stock value from highest to lowest.

SELECT product_name,
       category,
       price,
       quantity,
       (price * quantity) AS total_stock_value
FROM product
ORDER BY category ASC,
         total_stock_value DESC;


-- 99. Display the category-wise product count, average price,
-- total quantity, and total stock value, showing only categories
-- having more than one product.

SELECT category,
       COUNT(*) AS product_count,
       AVG(price) AS average_price,
       SUM(quantity) AS total_quantity,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
HAVING COUNT(*) > 1;


-- 100. Display the category-wise product count, total quantity,
-- average price, and total stock value; show only categories
-- having more than one product, and arrange them by
-- total stock value from highest to lowest.

SELECT category,
       COUNT(*) AS product_count,
       SUM(quantity) AS total_quantity,
       AVG(price) AS average_price,
       SUM(price * quantity) AS total_stock_value
FROM product
GROUP BY category
HAVING COUNT(*) > 1
ORDER BY total_stock_value DESC;